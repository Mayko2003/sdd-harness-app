---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { modulos, partes, niveles } from '../../data/modulos';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const ordenPartes = ['fundamentos', 'sdd', 'harness', 'integracion'] as const;
---

<BaseLayout title="Lecciones — SDD & Harness">
	<h1>Lecciones</h1>
	<p style="color:var(--muted)">
		Una página por módulo del mapa, en orden sugerido. Cada lección desarrolla los temas del módulo
		y enlaza las fuentes originales.
	</p>
	{ordenPartes.map((p) => (
		<section>
			<h2 class="section-title" style={`border-color:var(--c-${p})`}>{partes[p].nombre}</h2>
			<div class="lesson-grid">
				{modulos.filter((m) => m.parte === p).map((m) => (
					<a class="card lesson-card" href={`${base}lecciones/${m.id}/`} style={`border-left:3px solid var(--c-${p})`}>
						<div style="display:flex;gap:.5rem;align-items:center">
							<span class="lesson-id">{m.id}</span>
							<span class={`chip chip-${m.nivel}`}>{niveles[m.nivel].nombre}</span>
						</div>
						<h3 style="margin:.4rem 0 .3rem;font-size:1rem">{m.titulo}</h3>
						<p style="margin:0;color:var(--muted);font-size:.85rem">{m.resumen}</p>
						<p style="margin:.4rem 0 0;font-size:.8rem;color:var(--muted)">{m.temas.length} temas</p>
					</a>
				))}
			</div>
		</section>
	))}
</BaseLayout>
